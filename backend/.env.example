MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB=bongmabang
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
PORT=3000
# Comma-separated exact origins allowed to call the API from a browser.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://127.0.0.1:4174
